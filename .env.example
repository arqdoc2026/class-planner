# PostgreSQL / Prisma
# En Supabase, DATABASE_URL suele usar el pool transaccional y DIRECT_URL la
# conexión directa utilizada por las migraciones.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Supabase Auth (valores públicos que pueden llegar al navegador)
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="YOUR_PUBLISHABLE_KEY"

# Supabase Storage (solo servidor; nunca usar el prefijo NEXT_PUBLIC_)
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"

# Google Gemini (solo servidor)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Seeds exclusivamente para desarrollo o staging
SEED_DEFAULT_PASSWORD="CHANGE_ME_WITH_AT_LEAST_12_CHARACTERS"
ALLOW_TEST_SEED="false"
